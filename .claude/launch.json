{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8420"
      ],
      "cwd": "website",
      "port": 8420
    },
    {
      "name": "web-mockauth",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "cwd": "web",
      "port": 5174,
      "env": {
        "API_TARGET": "http://127.0.0.1:8081"
      }
    }
  ]
}