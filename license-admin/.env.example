# Copy this to .env and fill in real values. .env is git-ignored — never
# commit real secrets. See README.md for how to obtain/generate each one.

# --- Entitlement signing ------------------------------------------------
# PRIVATE_KEY_B64 from ~/Documents/PiperStitch-Licensing/PRIVATE_KEY_DO_NOT_SHARE.txt
# The matching PUBLIC key is baked into app/entitlement.py here and into the
# shipped app (EntitlementVerifier.swift) — this MUST be that same keypair.
PIPERSTITCH_LICENSE_PRIVATE_KEY=

# --- Admin login --------------------------------------------------------
ADMIN_USERNAME=admin
# A PBKDF2 hash, not the plaintext password: python3 scripts/set_admin_password.py
ADMIN_PASSWORD_HASH=
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# MUST be "true" in any real deployment. "false" only for local http testing.
SESSION_COOKIE_SECURE=false

# --- Stripe ---------------------------------------------------------------
# https://dashboard.stripe.com/apikeys (pk_test_/sk_test_ until you go live)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the webhook endpoint's page once created (see README) — whsec_...
STRIPE_WEBHOOK_SECRET=
# The ONE monthly recurring Price: python3 scripts/create_stripe_prices.py
STRIPE_PRICE_MONTHLY=

# --- Outgoing email (plain SMTP) ------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for STARTTLS on 587/25.
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PiperStitch <hello@piperstitch.com>
# A real monitored inbox for replies (welcome/failed-payment emails say "just reply") --
# hello@ above is Postmark's sending identity only, with no inbox behind it.
REPLY_TO_EMAIL=contact@piperstitch.com

# --- Postmark (this is what's actually live in production) ----------------
# Set this and ALL email (sign-in codes included) goes through Postmark's
# API instead of SMTP. From https://account.postmarkapp.com once you've
# created a Server and verified the piperstitch.com sending domain (Postmark
# gives you the DKIM record to add in DNS -- required for delivery, see
# README.md's Email deliverability section).
POSTMARK_API_TOKEN=
# e.g. "PiperStitch <hello@piperstitch.com>" — falls back to SMTP_FROM.
POSTMARK_FROM=
POSTMARK_MESSAGE_STREAM=outbound

# --- URLs -----------------------------------------------------------------
# Where THIS service is reachable, no trailing slash. http://127.0.0.1:8000 locally.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# The marketing site (website/ in the main repo).
WEBSITE_BASE_URL=https://www.piperstitch.com
# MUST match the feed URL baked into shipped builds — never change after shipping.
UPDATE_FEED_URL=https://www.piperstitch.com/updates/piperstitch-mac.json
DOWNLOAD_BASE_URL=https://www.piperstitch.com/downloads

# --- Website integration --------------------------------------------------
# Shared secret the website's register.php / get.php send as X-API-Key.
# python3 -c "import secrets; print(secrets.token_hex(32))" — same value in both PHP files.
INTAKE_API_KEY=
# Signs the direct-download link in reminder emails (get.php holds the same value).
DOWNLOAD_LINK_SECRET=
# Origins allowed to call POST /api/checkout via browser fetch().
CORS_ALLOWED_ORIGINS=https://piperstitch.com,https://www.piperstitch.com

# --- The subscription -----------------------------------------------------
# Price in cents. The website's static pages also state the price in prose —
# change both together (README → go-live checklist).
MONTHLY_PRICE_CENTS=2400
CURRENCY=usd
# In-app free trial length (the clock runs on the customer's Mac; this is for copy).
TRIAL_DAYS=14
# Days the app keeps working past a period end without a confirmed renewal.
ENTITLEMENT_GRACE_DAYS=5
# Hard ceiling on any one entitlement token's life, regardless of period end.
ENTITLEMENT_MAX_DAYS=30
# Macs that can be signed in to one subscription at once.
MAX_DEVICES=2
ACTIVATION_CODE_TTL_MINUTES=15
ACCOUNT_LINK_TTL_MINUTES=30
# Version date on website/terms.html; a web sign-in records acceptance of it.
# Bump together with the page when the Terms change.
TERMS_VERSION=2026-09-13

# --- Updates page (optional) ----------------------------------------------
# Leave blank to publish builds by hand. SFTP account that manages the website.
WEBSITE_SFTP_HOST=
WEBSITE_SFTP_PORT=22
WEBSITE_SFTP_USERNAME=
WEBSITE_SFTP_PASSWORD=
WEBSITE_SFTP_DOWNLOADS_PATH=public_html/downloads
WEBSITE_SFTP_UPDATES_PATH=public_html/updates

# --- Misc -------------------------------------------------------------------
DATABASE_PATH=./license_admin.db

# --- Web edition (repo: server/ + web/) ---
# Shared secret the Swift web server sends in X-API-Key for /api/web/*.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_API_KEY=
# Where the web app lives -- Stripe returns there after checkout/portal.
WEB_APP_URL=https://app.piperstitch.com
# Development only: write emails to this folder instead of sending them,
# so the sign-in code flow works with no mail server. Leave empty in production.
EMAIL_OUTBOX_DIR=
